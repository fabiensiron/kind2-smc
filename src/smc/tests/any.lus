-- expected:
-- P = 1 - 2^{-K}
-- ./bin/kind2 --enable SMC --smc_steps 1 --smc_runs 1000 src/smc/tests/any.lus
-- P ~= 0.5
-- ./bin/kind2 --enable SMC --smc_steps 2 --smc_runs 1000 src/smc/tests/any.lus
-- P ~= 0.75
-- ./bin/kind2 --enable SMC --smc_steps 3 --smc_runs 1000 src/smc/tests/any.lus
-- P ~= 0.875
-- ./bin/kind2 --enable SMC --smc_steps 5 --smc_runs 1000 src/smc/tests/any.lus
-- P ~= 0.96875

node main(x: bool) returns (a: int; ok: bool);
let
  a =
    any {
      y: int |
      (x and y = 1)
      or
      (not x and y = 0)
    };

  ok = a = 0;

  --%PROPERTY "any_follows_x" ok;
  --%MAIN ;
tel